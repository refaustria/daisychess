# systemd unit for the DaisyChess engine server (ADR-001: 127.0.0.1:8580).
# Install/refresh with deploy/deploy-server.sh (see deploy/README.md).
[Unit]
Description=DaisyChess engine server
After=network.target

[Service]
# Own journal namespace with 7-day retention (deploy/journald@daisychess.conf). Read with:
# journalctl --namespace=daisychess -u daisychess-server
LogNamespace=daisychess
Type=simple
User=bojan
Group=bojan
WorkingDirectory=/home/bojan/gitchess/apps/server
ExecStart=/usr/bin/node dist/index.js
Environment=PORT=8580 HOST=127.0.0.1 NODE_ENV=production
# Browser origins allowed on /ws (ADR-008); .env.production may override. ADR-021: the app is on
# play.daisychess.org; ADR-022: the iOS/Android apps' WebView origins (app.daisychess.org).
Environment=ALLOWED_ORIGINS=https://play.daisychess.org,https://app.daisychess.org,capacitor://app.daisychess.org
# Overrides (MAX_SESSIONS, MAX_THREADS, LOG_LEVEL, ...); git-ignored, optional.
EnvironmentFile=-/home/bojan/gitchess/apps/server/.env.production
# always: also restart after a clean exit, e.g. a stray SIGTERM (2026-10-25 outage).
Restart=always
RestartSec=2s
# Engine child processes are part of the service cgroup; stop them all.
KillMode=control-group
TimeoutStopSec=15s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# /home is read-only (repo, dist, engine binaries + NNUE are only read).
ProtectHome=read-only
# The only writable path: the review store (ADR-017, REVIEW_STORE_PATH, default
# apps/server/data/reviews.sqlite). The server creates the directory (UMask=0077 → mode 700).
ReadWritePaths=/home/bojan/gitchess/apps/server/data
# Do NOT set MemoryDenyWriteExecute: V8 JIT needs W+X memory.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other users' processes are invisible in /proc (ProcSubset=pid is NOT set: Stockfish and
# libuv read /proc/cpuinfo, /proc/stat and /proc/meminfo).
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
LockPersonality=true
UMask=0077
# No capabilities at all (runs as an unprivileged user and binds a high port).
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The server only ever talks to nginx on loopback and spawns local processes: no egress.
IPAddressDeny=any
IPAddressAllow=localhost
# Seccomp: the generic service profile (process management, networking, memory, timers).
# Everything outside it (mount, reboot, module loading, raw I/O, ptrace, ...) fails with EPERM
# instead of killing the process, so a rogue engine build degrades rather than crash-loops.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

# Resource limits (shared 16-core host, ADR-003)
MemoryMax=12G
CPUWeight=80
TasksMax=512

[Install]
WantedBy=multi-user.target
