# DaisyChess community node: copy to docker/.env.node (git-ignored) and fill in NODE_TOKEN.
# Read by docker/docker-compose.node.yml (container env + compose variables). Full reference:
# apps/server/.env.example ("ROLE=node") and deploy/README.md ("Run a community node").

# ---- hub link (ADR-020) ----------------------------------------------------------------------
# The hub's link endpoint: the public DaisyChess hub (ADR-021; the image's entrypoint uses the
# same default when this is empty). A self-hosted hub: wss://<your hub>/link. Must be wss://
# (plain ws:// only to a loopback host or with DAISYCHESS_INSECURE=1, for test setups only).
HUB_URL=wss://hub.daisychess.org/link
# Node token from the operator portal (dcn_<id>_<secret>, shown once when the node is created).
# Keep it secret: anyone with it can register as this node. Alternatively mount it as a file and
# set NODE_TOKEN_FILE=/run/secrets/node_token (compose `secrets:`), leaving NODE_TOKEN empty.
NODE_TOKEN=
#NODE_TOKEN_FILE=/run/secrets/node_token
# Local name for logs and /health/detail only (the name players see is set in the portal).
NODE_NAME=my-node
# on = offer this node to the shared pool (players without a node of their own); the portal's
# pool switch must allow it too. off = only the tokens you issue in the portal use it.
NODE_POOL=off

# ---- capacity ----------------------------------------------------------------------------------
# Engine sessions (one engine process each) this node runs at once; the hub never routes more.
MAX_SESSIONS=2
#NODE_MAX_SESSIONS=2
# Per-search caps announced to the hub (the node enforces them again on every request).
MAX_THREADS=1
MAX_HASH_MB=256
MAX_DEPTH=30
MAX_MULTIPV=5
MAX_MOVETIME_MS=60000
MAX_SESSIONS_PER_CONNECTION=2
# Human-like engines (Lc0 + Maia nets, ADR-019): off on very small machines (1 CPU / < 1 GB) or
# in an image built with WITH_MAIA=0 (then off automatically).
#MAIA=on
MAIA_MAX_PROCESSES=2
LOG_LEVEL=info

# ---- container resources (compose variables, not seen by the node) ---------------------------
# Rule of thumb: NODE_CPUS >= MAX_SESSIONS x MAX_THREADS, and
# NODE_MEMORY >= MAX_SESSIONS x (MAX_HASH_MB + 80m) + 200m (+ 20m per Maia process).
NODE_CPUS=2
NODE_MEMORY=1g
# Image to run (pin a version tag or digest for unattended hosts, e.g. :0.1.0 or @sha256:…).
#NODE_IMAGE=ghcr.io/refaustria/daisychess-node:latest
# Local builds only (docker compose … up --build): 0 = image without Lc0/Maia.
#WITH_MAIA=1
