# DaisyChess engine server environment (see apps/server/.env.example for all variables).
# HOST, PORT and ENGINES_CONFIG are set in the image; do not override unless needed.
MAX_SESSIONS=4
MAX_SESSIONS_PER_IP=2
# nginx runs in the `web` container (dynamic address on the compose network) and sets X-Real-IP;
# the server port is not published, so every peer is that proxy. Remove this line if you publish
# 8580 directly (clients could then spoof X-Real-IP), see docs/SECURITY.md.
TRUSTED_PROXIES=*
MAX_DEPTH=30
MAX_MULTIPV=5
MAX_THREADS=4
MAX_HASH_MB=512
MAX_MOVETIME_MS=600000
MAX_SESSIONS_PER_CONNECTION=2
ENGINE_IDLE_MS=300000
SESSION_IDLE_MS=600000
ENGINE_CRASH_RESET_MS=60000
ENGINE_MAX_CONSECUTIVE_CRASHES=10
LOG_LEVEL=info
# Review store (ADR-017): on the `reviews` volume (REVIEW_STORE_PATH is set in the image).
REVIEW_STORE=on
REVIEW_STORE_MAX_BYTES=5000000000
REVIEW_PUT_PER_IP_PER_DAY=500
# Browser origins allowed on /ws (ADR-008). Unset = same host as the request, which is right
# for the bundled `web` service on any WEB_PORT. Set it when the web app is hosted elsewhere:
#ALLOWED_ORIGINS=https://chess.example.com
