{
  "name": "daisychess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @daisychess/web dev",
    "fetch-engines": "bash scripts/fetch-engines.sh",
    "dev:server": "pnpm --filter @daisychess/server dev",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @daisychess/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
