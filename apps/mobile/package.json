{
  "name": "@daisychess/mobile",
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "pnpm --filter @daisychess/web build:mobile",
    "build": "pnpm run build:web && node scripts/check-dist.mjs && cap sync",
    "sync": "cap sync",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@daisychess/web": "workspace:*",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
