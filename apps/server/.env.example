# DaisyChess engine server configuration. All variables are optional; defaults shown.
# The server reads them from the process environment (systemd Environment=, or
# `node --env-file=.env dist/index.js`); it does not load .env by itself.
#
# Sections by role (ROLE, default standalone; ADR-020):
#   1. Common            engine pool, limits, logging       standalone, hub, node
#   2. ROLE=standalone   public WebSocket, rooms, reviews   standalone and hub (the hub is a superset)
#   3. ROLE=node         outbound link to a hub             node only (also docker/node.env.example)
#   4. ROLE=hub          /link, router, portal, spot-checks hub only (deploy/README.md "Hub runbook")
# A variable outside its role is ignored. Commented lines show the default or an example.

# ==== 1. Common (all roles) =====================================================================

# Listen address (ADR-001: nginx proxies /ws and /health to 127.0.0.1:8580).
PORT=8580
HOST=127.0.0.1

# Global cap on concurrently leased engine instances (all clients, all engines).
MAX_SESSIONS=4
# Cap on concurrently leased engine sessions per client address, over all of its connections
# (docs/SECURITY.md). Above it: `no_capacity` "too many sessions from your address".
# Must not exceed MAX_SESSIONS; default min(2, MAX_SESSIONS).
MAX_SESSIONS_PER_IP=2
# The client address is the TCP peer, or nginx's X-Real-IP header when the peer is loopback or
# listed here (comma-separated IPs; `*` = every peer, only if the port is not reachable
# directly, e.g. Docker with nginx in another container). Default: loopback only.
#TRUSTED_PROXIES=

# Per-connection limits announced in `welcome.limits` (ADR-006). Requests above them get
# `limit_exceeded`. MAX_MOVETIME_MS also caps the wall time of every search (incl. infinite).
MAX_DEPTH=30
MAX_MULTIPV=5
MAX_THREADS=4
MAX_HASH_MB=512
MAX_MOVETIME_MS=600000
MAX_SESSIONS_PER_CONNECTION=2

# Idle engine processes beyond one per engine are killed after this many ms.
ENGINE_IDLE_MS=300000
# A session without a running search gives its engine back after this many ms.
SESSION_IDLE_MS=600000

# Respawn backoff after engine crashes (unexpected exit or failed start): the n-th consecutive
# crash blocks new instances of that engine for min(500 ms * 2^(n-1), 30 s) +-20 %; meanwhile
# requests that would need a new process get `no_capacity`. The counter resets when an instance
# stays up ENGINE_CRASH_RESET_MS or completes a search. After ENGINE_MAX_CONSECUTIVE_CRASHES the
# engine shows `degraded: true` in /health/detail and is retried every 30 s.
ENGINE_CRASH_RESET_MS=60000
ENGINE_MAX_CONSECUTIVE_CRASHES=10

# Engine registry; relative paths resolve against the working directory.
# Default: apps/server/engines.json
#ENGINES_CONFIG=./engines.json

# fatal | error | warn | info | debug | trace | silent  (FENs are only logged at debug)
LOG_LEVEL=info

# Browser origins allowed to open /ws (ADR-008, docs/SECURITY.md). Comma-separated
# scheme://host[:port] list, or `*` to disable the check. Unset: the Origin header must
# name the same host as the request's Host header (loopback hosts are interchangeable, so
# the Vite dev server on :5180 can reach :8580). Requests without an Origin header
# (non-browser clients) are always accepted. Production sets it explicitly:
#ALLOWED_ORIGINS=https://play.daisychess.org

# ==== 2. ROLE=standalone (and hub): public /ws, rooms, review store ==============================

# Shared access token (ADR-010, ADR-013). When set, clients must send it in `hello.token` to
# analyse; a missing or wrong token (compared in constant time, never logged) gets a restricted
# `welcome` (no engines, `capabilities.analysis: false`) and `error unauthorized` on `analyze`,
# while "play a friend" rooms keep working. Unset or empty: the server is public. Max 256
# characters; generate one with `openssl rand -hex 16`. The web UI takes it in Settings →
# "Server access token".
#ACCESS_TOKEN=

# Rooms — play a friend via link (ADR-013). All optional; defaults shown.
# Live rooms of any status at once; creation above it gets `room.error too_many_rooms`.
ROOM_MAX_ROOMS=200
# Spectators per room (0 disables spectating).
ROOM_MAX_SPECTATORS=10
# `room.create` per client address within the window.
ROOM_CREATE_PER_IP=10
ROOM_CREATE_WINDOW_MS=600000
# A room nobody joined is abandoned (and deleted) after this long.
ROOM_WAITING_TTL_MS=900000
# A finished room is deleted this long after the game ended (reloads still see the result).
ROOM_FINISHED_TTL_MS=600000
# A running game without a move for this long is abandoned.
ROOM_IDLE_TTL_MS=7200000
# A player must be disconnected this long before the opponent may `room.claim`.
ROOM_CLAIM_GRACE_MS=60000

# Server-side review store (ADR-017): finished game reviews and position evaluations in one
# SQLite file (node:sqlite, Node >= 22.13; WAL), keyed by the game's hash — moves and evaluations
# only, no PGN headers, names or addresses. Reads (`review.get`) are open to every client; writes
# (`review.put`) need the access token. `off` disables it (`capabilities.reviewStore: false`);
# a missing node:sqlite or an unwritable path only disables it too (warning in the log).
REVIEW_STORE=on
# SQLite file; relative paths resolve against the working directory. The directory is created.
# The systemd unit must list its directory in ReadWritePaths= (deploy/README.md).
# Default: apps/server/data/reviews.sqlite
#REVIEW_STORE_PATH=./data/reviews.sqlite
# Disk cap in bytes (payload estimate). Above it the least recently used rows are deleted down
# to 90 % — positions first, then whole reviews. Default 5 GB; tune for a public release.
REVIEW_STORE_MAX_BYTES=5000000000
# `review.put` + `review.positions.put` per client address per UTC day (`reason: quota`).
# A reviewed game costs 1 + ceil(plies / 64) writes (typically 3).
REVIEW_PUT_PER_IP_PER_DAY=500

# Human-like engines: Lc0 + Maia (ADR-019). The nine registry entries maia-1100 … maia-1900
# (apps/server/engines.json, group `maia`) run `engines/lc0/lc0` (pnpm build-lc0) with the Maia
# nets in engines/maia/ (pnpm fetch-engines); they are disabled automatically when a file is
# missing. `off` disables them regardless (`welcome.engines[].enabled: false`).
MAIA=on
# Total Lc0 processes of all Maia levels together (~16 MB RSS each; a 1-node move takes a few
# ms). At the cap the least recently used idle Maia process is replaced; when all are in use,
# `analyze` gets `no_capacity`.
MAIA_MAX_PROCESSES=3
# Cap on `analyze.nodes` (node-limited searches, `limits.maxNodes`); Maia entries are capped at
# 1 node by the registry (`maxNodes`), so this only matters for Stockfish.
MAX_NODES=10000

# ==== 3. ROLE=node: community engine node (ADR-020 §7) =========================================
# `standalone` (default) = this server as before; `node` = the engine pool plus one outbound link
# to a hub, no /ws and no public listener (/health binds to loopback whatever HOST says); `hub`
# = standalone + /link + router + portal API (section 4). Docker: docker/docker-compose.node.yml and
# docker/node.env.example; deploy/README.md "Run a community node".
#ROLE=node
# The hub's link endpoint. wss:// only; plain ws:// to a loopback host (local dev hub) is allowed,
# to any other host only with DAISYCHESS_INSECURE=1 (tests, docker networks).
# Public hub (ADR-021): wss://hub.daisychess.org/link (the Docker image's default when unset).
#HUB_URL=wss://hub.daisychess.org/link
# Node token from the operator portal (dcn_<id>_<secret>). Never logged. In Docker, NODE_TOKEN_FILE
# (read by docker/node-entrypoint.sh) can point at a secret file instead.
#NODE_TOKEN=
# Local name for logs and /health/detail (not sent to the hub; the portal name is what players see).
#NODE_NAME=my-node
# on = offer this node to the shared pool (the portal decides too). Default off.
#NODE_POOL=off
# Node-wide session cap announced to the hub; at most MAX_SESSIONS (default MAX_SESSIONS).
#NODE_MAX_SESSIONS=2
# 1 allows a plain ws:// HUB_URL to a non-loopback host. Tests and private docker networks only.
#DAISYCHESS_INSECURE=0

# ==== 4. ROLE=hub: hub, link endpoint, router, operator portal (ADR-020) ========================
# ROLE=hub = standalone (section 2 applies, incl. ALLOWED_ORIGINS and TRUSTED_PROXIES) + /link for
# nodes + token router + hub store + portal API. Its own engines run as the built-in node `local`.
# Needs nginx locations /link, /api/portal/, /portal/ and the loopback egress proxy
# (deploy/nginx/); runbook in deploy/README.md. Minimal production set:
#   ROLE=hub  PUBLIC_ORIGIN=https://play.daisychess.org  HUB_ADMIN_LICHESS=<your lichess name>
#   ALLOWED_ORIGINS=https://play.daisychess.org
#   (nginx on loopback: TRUSTED_PROXIES not needed)
#ROLE=hub

# -- Public origin and administrators ------------------------------------------------------------
# Public origin of the hub: base of setup links and the portal's same-origin check (ADR-021: the
# app host, not hub.daisychess.org, which serves only /link). Unset: first ALLOWED_ORIGINS entry /
# request host.
#PUBLIC_ORIGIN=https://play.daisychess.org
# Comma-separated lichess usernames (case-insensitive) that become administrators at first login.
#HUB_ADMIN_LICHESS=
# Base URL of the loopback nginx egress proxy to lichess (one GET api/account per portal login).
# The unit keeps IPAddressDeny=any; install deploy/nginx/lichess-egress.conf.snippet.
#PORTAL_LICHESS_PROXY=http://127.0.0.1:8581/lichess/
# Timeout of that lichess call in ms.
#PORTAL_LICHESS_TIMEOUT_MS=5000

# -- Hub store (operators, nodes, tokens, usage): NOT reproducible, back it up -------------------
# SQLite file (node:sqlite, Node >= 22.13), relative paths resolve against the working directory;
# the directory must be in the unit's ReadWritePaths=. Default: apps/server/data/hub.sqlite
#HUB_STORE_PATH=./data/hub.sqlite
# Alias of HUB_STORE_PATH (if both are set they must agree).
#HUB_DB_PATH=
# Days of per-token/day usage aggregates kept (no IPs, no positions).
USAGE_RETENTION_DAYS=90

# -- Limits per operator and pool fairness -------------------------------------------------------
# Live (not revoked) nodes per operator.
PORTAL_MAX_NODES=10
# Live player + pool tokens per operator.
PORTAL_MAX_TOKENS=100
# Live pool tokens per operator (0 = operators cannot issue pool tokens).
POOL_TOKENS_PER_OPERATOR=20
# Daily engine-time budget per pool token in minutes (UTC day); 0 = off.
POOL_DAILY_BUDGET_MIN=30

# -- Built-in node `local` (the hub's own engines; capacity is MAX_SESSIONS from section 1) ------
# Name players see for the hub's own engines.
HUB_LOCAL_NAME=local
# Sessions of the hub's own engines donated to the shared pool (0 = keep them out of the pool).
HUB_LOCAL_POOL_SHARE=2

# -- Link endpoint /link (nodes connect here) ----------------------------------------------------
# Nodes older than this are refused with `node_outdated` (major.minor.patch[-pre]).
NODE_MIN_VERSION=0.0.0
# Version nodes are told is the latest (they log "a newer node is available"). Default: this server's.
#NODE_LATEST_VERSION=
# Concurrent /link sockets per client address.
LINK_MAX_PER_IP=5
# Cadence of node.status and the hub's ping on /link, in ms (1000..120000).
#LINK_HEARTBEAT_MS=10000
# How long a draining node may finish running searches, in ms (0..600000).
#LINK_DRAIN_MS=30000
# A /link socket without a valid node.hello is closed after this many ms.
LINK_HELLO_TIMEOUT_MS=10000
# Frames per second accepted from one node link.
#LINK_MAX_MSGS_PER_S=5000

# -- Spot-checks of pool nodes on `local` (ADR-020 M24-12 notes) ---------------------------------
# Fraction (0..1) of eligible pool searches re-run on `local`; 0 = off.
SPOTCHECK_RATE=0.02
# Checks started per rolling hour (bounds the CPU `local` spends on checks).
SPOTCHECK_MAX_PER_HOUR=20
# Max centipawns a node's move may be worse than local's best at the same depth.
SPOTCHECK_TOLERANCE_CP=50
# Max |reported - local| centipawns of the node's score; 0 = no score check.
SPOTCHECK_SCORE_TOLERANCE_CP=200
# Pool searches below this reported depth are never checked.
SPOTCHECK_MIN_DEPTH=10
# local checks at most this deep.
SPOTCHECK_MAX_DEPTH=16
# Time cap of one check in ms; a check that misses the depth is inconclusive.
SPOTCHECK_MOVETIME_MS=5000
# Rolling reputation window: latest N checks of the last 24 h.
SPOTCHECK_WINDOW=50
# Checks in the window before a node can be marked suspect.
SPOTCHECK_MIN_CHECKS=10
# Disagreement rate (0..1) above which a node becomes suspect (out of the pool).
SPOTCHECK_MAX_DISAGREE_RATE=0.2
# Hours a suspect node stays out of the pool before probation.
SPOTCHECK_COOLDOWN_H=24
# The suspect episode with this number is a permanent pool ban (only an administrator lifts it).
SPOTCHECK_MAX_EPISODES=3
