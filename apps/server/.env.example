# ChessLab engine server configuration. All variables are optional; defaults shown.
# The server reads them from the process environment (systemd Environment=, or
# `node --env-file=.env dist/index.js`); it does not load .env by itself.

# Listen address (ADR-001: nginx proxies /ws and /health to 127.0.0.1:8580).
PORT=8580
HOST=127.0.0.1

# Global cap on concurrently leased engine instances (all clients, all engines).
MAX_SESSIONS=4
# Cap on concurrently leased engine sessions per client address, over all of its connections
# (docs/SECURITY.md). Above it: `no_capacity` "too many sessions from your address".
# Must not exceed MAX_SESSIONS; default min(2, MAX_SESSIONS).
MAX_SESSIONS_PER_IP=2
# The client address is the TCP peer, or nginx's X-Real-IP header when the peer is loopback or
# listed here (comma-separated IPs; `*` = every peer, only if the port is not reachable
# directly, e.g. Docker with nginx in another container). Default: loopback only.
#TRUSTED_PROXIES=

# Per-connection limits announced in `welcome.limits` (ADR-006). Requests above them get
# `limit_exceeded`. MAX_MOVETIME_MS also caps the wall time of every search (incl. infinite).
MAX_DEPTH=30
MAX_MULTIPV=5
MAX_THREADS=4
MAX_HASH_MB=512
MAX_MOVETIME_MS=600000
MAX_SESSIONS_PER_CONNECTION=2

# Idle engine processes beyond one per engine are killed after this many ms.
ENGINE_IDLE_MS=300000
# A session without a running search gives its engine back after this many ms.
SESSION_IDLE_MS=600000

# Respawn backoff after engine crashes (unexpected exit or failed start): the n-th consecutive
# crash blocks new instances of that engine for min(500 ms * 2^(n-1), 30 s) +-20 %; meanwhile
# requests that would need a new process get `no_capacity`. The counter resets when an instance
# stays up ENGINE_CRASH_RESET_MS or completes a search. After ENGINE_MAX_CONSECUTIVE_CRASHES the
# engine shows `degraded: true` in /health/detail and is retried every 30 s.
ENGINE_CRASH_RESET_MS=60000
ENGINE_MAX_CONSECUTIVE_CRASHES=10

# Engine registry; relative paths resolve against the working directory.
# Default: apps/server/engines.json
#ENGINES_CONFIG=./engines.json

# fatal | error | warn | info | debug | trace | silent  (FENs are only logged at debug)
LOG_LEVEL=info

# Browser origins allowed to open /ws (ADR-008, docs/SECURITY.md). Comma-separated
# scheme://host[:port] list, or `*` to disable the check. Unset: the Origin header must
# name the same host as the request's Host header (loopback hosts are interchangeable, so
# the Vite dev server on :5180 can reach :8580). Requests without an Origin header
# (non-browser clients) are always accepted. Production sets it explicitly:
#ALLOWED_ORIGINS=https://c.referee.at

# Shared access token (ADR-010, ADR-013). When set, clients must send it in `hello.token` to
# analyse; a missing or wrong token (compared in constant time, never logged) gets a restricted
# `welcome` (no engines, `capabilities.analysis: false`) and `error unauthorized` on `analyze`,
# while "play a friend" rooms keep working. Unset or empty: the server is public. Max 256
# characters; generate one with `openssl rand -hex 16`. The web UI takes it in Settings →
# "Server access token".
#ACCESS_TOKEN=

# Rooms — play a friend via link (ADR-013). All optional; defaults shown.
# Live rooms of any status at once; creation above it gets `room.error too_many_rooms`.
ROOM_MAX_ROOMS=200
# Spectators per room (0 disables spectating).
ROOM_MAX_SPECTATORS=10
# `room.create` per client address within the window.
ROOM_CREATE_PER_IP=10
ROOM_CREATE_WINDOW_MS=600000
# A room nobody joined is abandoned (and deleted) after this long.
ROOM_WAITING_TTL_MS=900000
# A finished room is deleted this long after the game ended (reloads still see the result).
ROOM_FINISHED_TTL_MS=600000
# A running game without a move for this long is abandoned.
ROOM_IDLE_TTL_MS=7200000
# A player must be disconnected this long before the opponent may `room.claim`.
ROOM_CLAIM_GRACE_MS=60000
